generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SUPPORT
  CUSTOMER
}

enum CustomerType {
  INDIVIDUAL
  LEGAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  password            String
  name                String?
  phone               String?
  alternatePhone      String?
  address             String?
  avatarUrl           String?
  role                Role           @default(CUSTOMER)
  customerType        CustomerType   @default(INDIVIDUAL)
  companyName         String?
  economicCode        String?
  approvalStatus      ApprovalStatus @default(APPROVED)
  notes               String?        @db.Text
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean        @default(false)
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  posts                 BlogPost[]
  mediaAssets           MediaAsset[]
  tickets               Ticket[]
  ticketReplies         TicketReply[]
  contracts             Contract[]
  orders                Order[]
  cannedResponses       CannedResponse[]
  notifications         Notification[]
  productComments       ProductComment[]
  customerFiles         CustomerFile[]   @relation("CustomerFiles")
  uploadedCustomerFiles CustomerFile[]   @relation("UploadedCustomerFiles")

  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@map("notifications")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_REPLY
  ANSWERED
  CLOSED
}

model Ticket {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  subject          String
  message          String       @db.Text
  status           TicketStatus @default(OPEN)
  messageSeenAt    DateTime?
  customerTypingAt DateTime?
  staffTypingAt    DateTime?
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  replies TicketReply[]

  @@index([userId])
  @@map("tickets")
}

model TicketReply {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  message     String             @db.Text
  attachments TicketAttachment[]
  seenAt      DateTime?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@index([ticketId])
  @@map("ticket_replies")
}

model TicketAttachment {
  id        String      @id @default(cuid())
  replyId   String
  reply     TicketReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime    @default(now())

  @@index([replyId])
  @@map("ticket_attachments")
}

model CannedResponse {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("canned_responses")
}

enum ContractStatus {
  PENDING_APPROVAL
  ACTIVE
  RENEWING
  EXPIRED
  CANCELLED
}

model Contract {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  title                String
  type                 String
  startDate            DateTime
  endDate              DateTime
  status               ContractStatus @default(ACTIVE)
  fileUrl              String?
  expiryReminderSentAt DateTime?
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@map("contracts")
}

model ContractType {
  id        String   @id @default(cuid())
  label     String   @unique
  createdAt DateTime @default(now())

  @@map("contract_types")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nullable: a custom/manual line item (not tied to a catalog product) has
  // no productId. When set, onDelete: SetNull keeps the historical order line
  // intact (with its own snapshot name/price) even if the product is later
  // removed from the catalog.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  // Snapshot of the unit price at order time (catalog default or manually
  // entered) — nullable only so existing pre-price orders don't need a
  // migration backfill; every new item submitted through the form requires it.
  price       Int?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String    @db.Text
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  viewCount   Int       @default(0)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId])
  @@map("blog_posts")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("page_views")
}

enum MediaScope {
  SITE_CONTENT
  TICKET_ATTACHMENT
  PROFILE_AVATAR
  CONTRACT_FILE
}

model MediaAsset {
  id           String     @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  scope        MediaScope @default(SITE_CONTENT)
  uploadedById String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())

  @@index([uploadedById])
  @@index([scope])
  @@map("media_assets")
}

model CustomerFile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("CustomerFiles", fields: [userId], references: [id], onDelete: Cascade)
  title        String
  url          String
  filename     String
  mimeType     String
  size         Int
  uploadedById String
  uploadedBy   User     @relation("UploadedCustomerFiles", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("customer_files")
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  CALL
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?   @db.Text
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("brands")
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children  ProductCategory[] @relation("CategoryTree")
  order     Int      @default(0)
  // Which admin-product-form spec template (src/lib/product-spec-templates.ts)
  // applies to products under this root category — set on the root only,
  // read by walking up from a product's own category. Deliberately NOT
  // derived from `slug`: slug is regenerated from `name` on every category
  // edit (see the categories PATCH route), so it can't be trusted as a
  // stable key. Null means "use the general default template".
  specTemplateKey String?
  // Ordered subset of that template's labels to show in the product card's
  // quick-preview popover on the catalog listing — same root-only convention
  // as specTemplateKey. Null/empty means "use the default fallback" (the
  // product's first few specs, see ProductCard.tsx).
  previewSpecKeys Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?             @db.Text
  images       Json
  specs        Json
  categoryId   String?
  category     ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId      String?
  brand        Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  availability ProductAvailability @default(IN_STOCK)
  showPrice    Boolean             @default(false)
  price        Int?
  isActive     Boolean             @default(true)
  deletedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  comments   ProductComment[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([deletedAt])
  @@map("products")
}

model ProductComment {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  text      String         @db.Text
  rating    Int?
  status    ApprovalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([productId])
  @@index([productId, status])
  @@map("product_comments")
}
