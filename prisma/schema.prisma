generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SUPPORT
  CUSTOMER
}

enum CustomerType {
  INDIVIDUAL
  LEGAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String
  name           String?
  phone          String?
  role           Role           @default(CUSTOMER)
  customerType   CustomerType   @default(INDIVIDUAL)
  companyName    String?
  economicCode   String?
  approvalStatus ApprovalStatus @default(APPROVED)
  notes          String?        @db.Text
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  posts           BlogPost[]
  mediaAssets     MediaAsset[]
  tickets         Ticket[]
  ticketReplies   TicketReply[]
  contracts       Contract[]
  orders          Order[]
  cannedResponses CannedResponse[]

  @@map("users")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

model Ticket {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  subject       String
  message       String       @db.Text
  status        TicketStatus @default(OPEN)
  messageSeenAt DateTime?
  customerTypingAt DateTime?
  staffTypingAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  replies TicketReply[]

  @@index([userId])
  @@map("tickets")
}

model TicketReply {
  id             String    @id @default(cuid())
  ticketId       String
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  message        String    @db.Text
  attachments    TicketAttachment[]
  seenAt         DateTime?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([ticketId])
  @@map("ticket_replies")
}

model TicketAttachment {
  id        String      @id @default(cuid())
  replyId   String
  reply     TicketReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime    @default(now())

  @@index([replyId])
  @@map("ticket_attachments")
}

model CannedResponse {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("canned_responses")
}

enum ContractStatus {
  PENDING_APPROVAL
  ACTIVE
  RENEWING
  EXPIRED
  CANCELLED
}

model Contract {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  title     String
  type      String
  startDate DateTime
  endDate   DateTime
  status    ContractStatus @default(ACTIVE)
  fileUrl   String?
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@map("contracts")
}

model ContractType {
  id        String   @id @default(cuid())
  label     String   @unique
  createdAt DateTime @default(now())

  @@map("contract_types")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  quantity    Int

  @@index([orderId])
  @@map("order_items")
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String   @db.Text
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@map("blog_posts")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@map("media_assets")
}
