# Copy this file to .env.local and adjust as needed.

# Base URL for product images/videos. Points at the local public/media
# folder by default; swap in a media-host URL once one exists.
NEXT_PUBLIC_MEDIA_URL=/media

# Absolute site URL — used for links inside emails/SMS (and anywhere else an
# absolute, not relative, URL is required). Set to the real domain in
# production; localhost is fine for dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL connection string, e.g.
# mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
DATABASE_URL=

# NextAuth.js — random secret used to sign session tokens/cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full site URL NextAuth uses for callbacks (e.g. https://yasharindustry.com).
NEXTAUTH_URL=

# Used once by `npm run db:seed` to create the first admin user.
# Not read anywhere else — safe to remove after the first seed.
ADMIN_EMAIL=pouyeshgen@gmail.com
ADMIN_PASSWORD=Pouyesh@123

# Cloudflare Turnstile (CAPTCHA) on the login/register forms.
# Get both from dash.cloudflare.com > Turnstile > Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry error tracking. Create a free project at sentry.io.
# Both must hold the same DSN value (see README/report for why there are two).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only for source-map upload, from sentry.io > Settings > Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend (transactional email). Get the API key from resend.com > API Keys.
RESEND_API_KEY=
# "name <email@your-verified-domain>" — must use a domain verified in Resend.
RESEND_FROM_EMAIL="پویش راه صنعت یاشار <onboarding@resend.dev>"

# Kavenegar (SMS). Get the API key from kavenegar.com > پنل کاربری > وب‌سرویس.
KAVENEGAR_API_KEY=
# Optional — a purchased sender line; leave empty to use the shared default.
KAVENEGAR_SENDER_LINE=
