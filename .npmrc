# ParsPack's own docs (docs.parspack.com/reference/mirror/npm-nodejs) document
# that build-time network fluctuations against the public npm registry cause
# intermittent timeout/disconnect errors on their PaaS, and recommend this
# internal mirror as the fix. Pointing installs at it here (instead of only
# via a manual `npm config set`) makes every `npm install`/`npm ci` run in
# this repo — on ParsPack and locally — use it automatically.
registry=https://mirror.abrha.net/repository/npm/
