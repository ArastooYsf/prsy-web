# Copy this file to .env.local and adjust as needed.

# Base URL for product images/videos. Points at the local public/media
# folder by default; swap in a media-host URL once one exists. See
# docs/media-hosting.md — changing this to an external host also requires
# setting it at ParsPack's Build stage (not just runtime ENV), since
# Next.js inlines NEXT_PUBLIC_* vars at build time.
NEXT_PUBLIC_MEDIA_URL=/media

# --- File storage (public: SITE_CONTENT, PRODUCT_COMMENT scopes) ---
# Driver for large PUBLIC files. "local" (default) writes to public/media/
# as today. Switch to "sftp" or "s3" once a download host is purchased —
# see docs/media-hosting.md. Optional.
MEDIA_STORAGE_DRIVER=local

# Only used when MEDIA_STORAGE_DRIVER=sftp. Optional otherwise.
MEDIA_SFTP_HOST=
MEDIA_SFTP_PORT=22
MEDIA_SFTP_USERNAME=
MEDIA_SFTP_PASSWORD=
MEDIA_SFTP_REMOTE_DIR=media

# Only used when MEDIA_STORAGE_DRIVER=s3 (works with any S3-compatible
# host, not just AWS — MinIO, Arvan, Liara, etc). Optional otherwise.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=true

# --- File storage (private: ticket attachments, contracts, avatars,
# customer files — never public, always local disk, never driver-switched.
# See docs/media-hosting.md). Default: <project root>/private-uploads.
# ⚠️ ParsPack's disk is not persistent — private files are lost on every
# redeploy/restart until this points at persistent storage. Optional.
UPLOAD_PRIVATE_DIR=

# Comma-separated allow-listed domain(s) for the admin "add from download
# host" fields (Product catalog/video, site-content downloads). Optional —
# leave empty to reject every absolute-URL "add from download host" input.
DOWNLOAD_HOST_ALLOWED_DOMAIN=

# Absolute site URL — used for links inside emails/SMS (and anywhere else an
# absolute, not relative, URL is required). Set to the real domain in
# production; localhost is fine for dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL connection string, e.g.
# mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
DATABASE_URL=

# NextAuth.js — random secret used to sign session tokens/cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full site URL NextAuth uses for callbacks (e.g. https://yasharindustry.com).
NEXTAUTH_URL=

# Used once by `npm run db:seed` to create the first admin user.
# Not read anywhere else — safe to remove after the first seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudflare Turnstile (CAPTCHA) on the login/register forms.
# Get both from dash.cloudflare.com > Turnstile > Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry error tracking. Create a free project at sentry.io.
# Both must hold the same DSN value (see README/report for why there are two).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only for source-map upload, from sentry.io > Settings > Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend (transactional email). Get the API key from resend.com > API Keys.
RESEND_API_KEY=
# "name <email@your-verified-domain>" — must use a domain verified in Resend.
RESEND_FROM_EMAIL="پویش راه صنعت یاشار <onboarding@resend.dev>"

# Kavenegar (SMS). Get the API key from kavenegar.com > پنل کاربری > وب‌سرویس.
KAVENEGAR_API_KEY=
# Optional — a purchased sender line; leave empty to use the shared default.
KAVENEGAR_SENDER_LINE=

# Password protecting the encrypted log-export zip (admin > logs). REQUIRED in
# production: if unset, the zip falls back to a placeholder that is public in
# the source code, i.e. effectively unprotected.
LOG_EXPORT_PASSWORD=
# Optional — where daily logs are stored. Default: ~/.prsy-website/logs.
# Point it at a persistent volume so redeploys don't wipe it.
LOG_DIR=
# Optional — path to the 7z binary used for the log export (default: 7z).
SEVEN_ZIP_PATH=

# Google Analytics 4 measurement id (G-XXXXXXX). Empty = analytics disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# National-ID verification (api.ir). Token from api.ir panel.
API_IR_TOKEN=
# Optional — override only for testing; default https://s.api.ir
API_IR_BASE_URL=

# Optional — admin > logs "Lighthouse" button audits this URL. Default is
# http://localhost:$PORT (the app itself); set the public https URL on the host.
LIGHTHOUSE_TARGET_URL=
# Optional — Chromium binary used by that Lighthouse run.
CHROME_PATH=

# Optional — used only by `npm run db:backup` when MySQL runs in Docker.
DB_DOCKER_CONTAINER=

# Optional — extra seed accounts created by `npm run db:seed` (dev only).
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
SUPPORT_EMAIL=
SUPPORT_PASSWORD=
