# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — only the placeholder template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/src/generated/prisma

# admin-uploaded media (lives on the host, not in version control)
/public/media/uploads

# event logs (host-local, contain user emails/ids — not version control)
/logs

# local DB backups (contain real user data)
/backups

# legacy upload folders (uploads now live in /public/media/uploads)
/public/media/contracts
/public/media/ticket-attachments

# personal/local Claude Code state
/.claude
*.graphify-bak

# logs
*.log

# dev tooling — generated/installed locally, not part of the deployed app
/graphify-out
/.agents/skills
/.superpowers
/skills-lock.json

# Strix pentest run output — may contain real vulnerability details, never commit
/strix_runs

# never commit these, even if they show up later
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.p12
*.pfx
id_rsa*
id_ed25519*
