# @prisma/engines' postinstall downloads a binary from https://binaries.prisma.sh
# (a host outside the npm registry/mirror) and registers its own process
# signal handlers while doing so — on ParsPack's build container this appears
# to hang/fail and trips npm's own "Exit handler never called!" bug during
# `npm install`, unrelated to which package versions are pinned. `npm run build`
# runs `prisma generate` explicitly afterward, which is unaffected by this.
ignore-scripts=true
