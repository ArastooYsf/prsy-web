# Copy this file to .env.local and adjust as needed.

# Base URL for product images/videos. Points at the local public/media
# folder by default; swap in a media-host URL once one exists.
NEXT_PUBLIC_MEDIA_URL=/media

# Absolute site URL — used for links inside emails/SMS (and anywhere else an
# absolute, not relative, URL is required). Set to the real domain in
# production; localhost is fine for dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MySQL connection details, as five separate values (not one hand-typed
# connection string — assembled at runtime in src/lib/db-connection-string.ts,
# which also URL-encodes each part, so special characters in the password
# are never a problem). DB_PORT defaults to 3306 if left blank.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional — set to "true" only if the DB host requires a TLS connection.
DB_SSL=

# NextAuth.js — random secret used to sign session tokens/cookies.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Full site URL NextAuth uses for callbacks (e.g. https://yasharindustry.com).
NEXTAUTH_URL=

# Used once by `npm run db:seed` to create the first admin user.
# Not read anywhere else — safe to remove after the first seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudflare Turnstile (CAPTCHA) on the login/register forms.
# Get both from dash.cloudflare.com > Turnstile > Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry error tracking. Create a free project at sentry.io.
# Both must hold the same DSN value (see README/report for why there are two).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only for source-map upload, from sentry.io > Settings > Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend (transactional email). Get the API key from resend.com > API Keys.
RESEND_API_KEY=
# "name <email@your-verified-domain>" — must use a domain verified in Resend.
RESEND_FROM_EMAIL="پویش راه صنعت یاشار <onboarding@resend.dev>"

# Kavenegar (SMS). Get the API key from kavenegar.com > پنل کاربری > وب‌سرویس.
KAVENEGAR_API_KEY=
# Optional — a purchased sender line; leave empty to use the shared default.
KAVENEGAR_SENDER_LINE=

# Password protecting the encrypted log-export zip (admin > logs). REQUIRED in
# production: if unset, the zip falls back to a placeholder that is public in
# the source code, i.e. effectively unprotected.
LOG_EXPORT_PASSWORD=
# Optional — where daily logs are stored. Default: ~/.prsy-website/logs.
# Point it at a persistent volume so redeploys don't wipe it.
LOG_DIR=
# Optional — path to the 7z binary used for the log export (default: 7z).
SEVEN_ZIP_PATH=

# Google Analytics 4 measurement id (G-XXXXXXX). Empty = analytics disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# National-ID verification (api.ir). Token from api.ir panel.
API_IR_TOKEN=
# Optional — override only for testing; default https://s.api.ir
API_IR_BASE_URL=

# Optional — admin > logs "Lighthouse" button audits this URL. Default is
# http://localhost:$PORT (the app itself); set the public https URL on the host.
LIGHTHOUSE_TARGET_URL=
# Optional — Chromium binary used by that Lighthouse run.
CHROME_PATH=

# Optional — used only by `npm run db:backup` when MySQL runs in Docker.
DB_DOCKER_CONTAINER=

# Optional — extra seed accounts created by `npm run db:seed` (dev only).
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
SUPPORT_EMAIL=
SUPPORT_PASSWORD=
